{
  "manifest_version": 3,
  "name": "ChapterLens",
  "version": "0.2.0",
  "description": "YouTube の動画に、話題の切り替えから作った目次(チャプター)を重ねて表示します。字幕があれば拡張の中だけで処理します。字幕が無い動画では、この PC の中のエンジン(127.0.0.1)だけに音声を渡して文字にします。",
  "key": "",
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "ChapterLens: 音声から目次を作る",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/capture.js",
        "src/transcript.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
